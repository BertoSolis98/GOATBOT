# Settings for running GoatBot in Docker (compose.yaml). Copy to docker/goatbot.env and fill in.
# Never commit docker/goatbot.env.

# ---- where you open the app ----
# The address you type in the browser. With Tailscale this is https://<pc-name>.<tailnet>.ts.net
# (`tailscale serve status` shows it). On the PC alone: http://localhost:8787
APP_URL=http://localhost:8787
SERVER_URL=http://localhost:8787

# Who may sign in (comma-separated). Put your own email here.
ALLOWED_EMAILS=you@example.com

# ---- how many bots ----
# Each bot is a desktop plus Chrome (about 1.5-2 GB). 2 is right for a 16 GB PC.
MAX_BOTS=2
# Size of each bot's screen.
HQ_SCREEN_SIZE=1280x800

# ---- keys ----
# The bots' model. Or leave it empty and sign in to a subscription from a bot's Engine panel.
ANTHROPIC_API_KEY=
# Connected apps (Gmail, Slack, ...). Get one at composio.dev. Needs a value to start ("none" if you skip apps for now).
COMPOSIO_API_KEY=none
# Voice and X search. The app needs a value to start; with "none" those two features just fail.
XAI_API_KEY=none

# Made for you on first start and kept in the volume. Set it only to move an install.
# SESSION_SECRET=

# Ask before shell commands, code, opening sites and screen control (0 = off).
GATE_COMPUTER_ACTIONS=1
